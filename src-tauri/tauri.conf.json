{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VetCord",
  "version": "0.3.0",
  "identifier": "app.vetcord.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "VetCord contributors",
    "copyright": "Copyright (c) 2026 VetCord contributors",
    "category": "SocialNetworking",
    "shortDescription": "Lightweight open-source Discord client",
    "longDescription": "VetCord loads Discord's official web client in a lightweight Rust/Tauri shell with debloat controls and automatic gameplay clipping.",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
